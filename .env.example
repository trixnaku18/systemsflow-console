# Supabase (Project Settings → API)
# NEXT_PUBLIC_ prefix optional; SUPABASE_URL and SUPABASE_ANON_KEY also work
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GHL private integration (sub-account: Optogrow Operations Management Solutions)
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
# Shared secret GHL workflow webhooks must send in the x-systemsflow-secret header
GHL_WEBHOOK_SECRET=
